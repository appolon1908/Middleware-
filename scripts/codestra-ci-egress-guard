#!/usr/bin/env bash
set -euo pipefail

IPTABLES=/usr/sbin/iptables
TARGETS=(
  65.109.65.169/32
  65.21.67.207/32
  37.27.128.39/32
  10.40.0.0/24
)
CHAINS=(OUTPUT FORWARD)

apply_rules() {
  for target in "${TARGETS[@]}"; do
    for chain in "${CHAINS[@]}"; do
      if ! "${IPTABLES}" -C "${chain}" -d "${target}" -j REJECT >/dev/null 2>&1; then
        "${IPTABLES}" -I "${chain}" 1 -d "${target}" -j REJECT
      fi
    done
  done
  echo "CI_RUNTIME_EGRESS_DENY=PASS"
}

check_rules() {
  for target in "${TARGETS[@]}"; do
    for chain in "${CHAINS[@]}"; do
      "${IPTABLES}" -C "${chain}" -d "${target}" -j REJECT >/dev/null
    done
  done
  echo "CI_RUNTIME_EGRESS_DENY=PASS"
}

case "${1:-}" in
  apply) apply_rules ;;
  check) check_rules ;;
  *)
    echo "usage: $0 {apply|check}" >&2
    exit 64
    ;;
esac
