{
  "info": {
    "name": "Middleware V3 API Synthetic",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Localhost-only, in-memory API certification. Uses TEST_SYN commands and never runs a command worker or provider effect."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8095"
    },
    {
      "key": "bearer_token",
      "value": ""
    },
    {
      "key": "command_id",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!/^http:\\/\\/(127\\.0\\.0\\.1|localhost):8095$/.test(pm.variables.get(\"base_url\"))) { throw new Error(\"Synthetic certification requires localhost:8095\"); }",
          "if (!pm.collectionVariables.get(\"command_id\")) { pm.collectionVariables.set(\"command_id\", pm.variables.replaceIn(\"{{$guid}}\")); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Submit synthetic command",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearer_token}}"
          },
          {
            "key": "X-Correlation-ID",
            "value": "corr-{{command_id}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "idem-{{command_id}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/platform/v1/commands",
        "body": {
          "mode": "raw",
          "raw": "{\"command_id\": \"{{command_id}}\", \"command_type\": \"test.syn.execute.v1\", \"tenant_id\": \"TEST_SYN\", \"requested_by\": \"user-1\", \"correlation_id\": \"corr-{{command_id}}\", \"idempotency_key\": \"idem-{{command_id}}\", \"payload\": {\"probe\": true}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", function () { pm.response.to.have.status(202); });",
              "pm.test(\"Correlation is present\", function () { pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\").and.not.empty; });",
              "pm.test(\"Operation correlation is stable\", function () { pm.expect(pm.response.json().correlation_id || pm.response.headers.get(\"X-Correlation-ID\")).to.eql(pm.response.headers.get(\"X-Correlation-ID\")); });"
            ]
          }
        }
      ]
    },
