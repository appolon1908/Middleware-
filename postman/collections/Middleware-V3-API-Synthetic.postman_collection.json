    {
      "name": "Oversized body rejected before JSON parsing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/platform/v1/commands",
        "body": {
          "mode": "raw",
          "raw": "{{oversized_body}}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"oversized_body\", \"{\".repeat(1048577));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Body limit precedes parsing\", function () { pm.response.to.have.status(413); pm.expect(pm.response.json().error.code).to.eql(\"payload_too_large\"); });",
              "pm.test(\"Error correlation matches\", function () { pm.expect(pm.response.json().error.correlation_id).to.eql(pm.response.headers.get(\"X-Correlation-ID\")); });"
            ]
          }
        }
      ]
    }
