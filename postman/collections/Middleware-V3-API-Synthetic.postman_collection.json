              "pm.test(\"Canonical error envelope\", function () { const e = pm.response.json().error; pm.expect(e).to.have.all.keys(\"code\", \"message\", \"correlation_id\", \"retryable\", \"details\"); pm.expect(e.correlation_id).to.eql(pm.response.headers.get(\"X-Correlation-ID\")); });"
            ]
          }
        }
      ]
